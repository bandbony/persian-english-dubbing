# Copy to .env and fill in. Only the keys for the services you use are needed.

ANTHROPIC_API_KEY=          # translation (Claude)
OPENAI_API_KEY=             # Persian speech-to-text (Whisper API)
ELEVENLABS_API_KEY=         # English voice and voice cloning
SYNC_API_KEY=               # lip sync (sync.so), only for jobs with lip sync on

# sync.so downloads the video and voice from this app, so it must be reachable from the internet,
# e.g. https://dub.example.com or an ngrok/cloudflared tunnel. Needed only for lip sync.
PUBLIC_BASE_URL=

# Password for the web page. Set this whenever the app is reachable from the internet.
APP_PASSWORD=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# TRANSCRIBER=openai          # or whisperx (local GPU, pip install whisperx)
# SEPARATOR=demucs            # or none (no background music kept)
# CLONE_VOICE=true
# ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# SYNC_MODEL=lipsync-2        # lipsync-2-pro or sync-3 for higher quality, at higher cost
# MAX_SPEEDUP=1.35
# DATA_DIR=data
